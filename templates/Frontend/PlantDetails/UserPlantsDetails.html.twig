{% extends 'base.html.twig' %}

{% block title %}
Détail de la plante
{{ parent() }}
{% endblock %}

{% block body %}
{% include "Layout/nav.html.twig" %}
<aside>
    {# <span class="return">
        <a href="{{ path('users.index') }}"><img src="{{ asset('img/components/Cross.svg') }}"
                alt="Retour arrière"></a>
    </span> #}
    <div class="plantPic">
        <img src="{{ vich_uploader_asset(plant, 'image') }}" alt="{{ plant.name }}">
    </div>

</aside>
<main>
    <div class="plantCard">
        <div class="cardText">

            <div class="delButton">
                <form action="{{path('userPlants.details.delete', {name: plant.Name, id: plantdetail.id}) }}"
                    method="POST"
                    onsubmit="return confirm('Êtes-vous certain de vouloir supprimer cette plante? Cette action est irréversible')"
                    enctype="multipart/form-data">
                    <input type="hidden" name="token" value="{{ csrf_token('delete'~ plantdetail.id) }}">
                    <label for="removePlant">Supprimer cette plante de ma collection</label>
                    <button type="submit" class="removePlant" id="removePlant">
                        <img src="{{ asset('img/components/minus.png') }}" alt="Bouton de suppression moins">
                    </button>
                </form>
            </div>

            <section>
                <div class="plantHeader">
                    <h2>Plante : {{ plant.Name }}</h2>
                    <h3>Espèce: {{ plant.species.Name }}</h3>
                </div>

                <div class="plantInfos">
                    <div class="categUnit">
                        <span>Description:
                            <p class="description">{{ plant.Description }}</p>
                        </span>
                    </div>
            </section>

            <section>
                <div class="categFields">

                    <span>Statut de la plante:</span>
                    <div class="categUnit">

                        <div class="categClass">
                            {% if plantdetail.HealthStatus %}
                            <p class="categComponent">{{ plantdetail.HealthStatus.Name }}</p>

                            {% else %}
                            <p>Aucun statut de santé précisé.</p>
                            {% endif %}
                        </div>
                    </div>

                    <span>Maladies: </span>
                    <div class="categUnit">

                        <div class="categClass">
                            {% if plantdetail.diseases|length > 0 %}
                            {% if plantdetail.HealthStatus.Name == "Malade" %}
                            {% for disease in plantdetail.diseases %}
                            <div class="categComponent">{{ disease.Name }}</div>
                            {% endfor %}
                            {% else %}
                            <p>Aucune maladie précisée.</p>
                            {% endif %}
                            {% endif %}
                        </div>
                    </div>

                    <div class="categUnit">
                        <div class="categClass">
                            {% if plantdetail.diseases|length > 0 %}
                            {% if plantdetail.HealthStatus.Name == "Malade" %}
                            <span>Description de la maladie:</span>
                            {% for disease in plantdetail.diseases %}
                            <span>{{ disease.Description }}</span>
                            {% endfor %}

                            {% endif %}
                            {% endif %}
                        </div>
                    </div>

                    <span>Journal: </span>
                    <div class="categUnit">
                        <div class="categClass">
                            {% if plantdetail.Journal %}
                            <div class="diaryClass">{{ plantdetail.Journal|nl2br }}</div>
                            {% else %}
                            <span>Aucun journal disponible.</span>
                            {% endif %}
                        </div>
                    </div>

                    <span>Catégorie(s)</span>
                    <div class="categUnit">
                        <div class="categClass">
                            {% for category in plant.categories %}
                            <span class="categComponent">{{ category.Name }}</span>
                            {% endfor %}
                        </div>
                    </div>

                    <span>Saisonalité</span>
                    <div class="categUnit">
                        <div class="categClass">
                            {% for season in plant.seasons %}
                            <div class="categComponent">{{ season.Name }}</div>
                            {% endfor %}
                        </div>
                    </div>

                    <span>Arrosage</span>
                    <div class="categUnit">
                        <div class="categClass">

                            {% if plant.watering %}
                            <div class="categComponent">{{ plant.watering.quantity }} ml</div>
                            {% else %}
                            <div class="categComponent">Aucun arrosage défini</div>
                            {% endif %}

                            {% if plant.watering %}
                            <div class="categComponent">1 fois tous les {{ plant.watering.frequency }} jours</div>
                            {% else %}
                            <div class="categComponent">Aucun arrosage défini</div>
                            {% endif %}
                        </div>
                    </div>

                    <span>Couleurs</span>
                    <div class="categUnit">
                        <div class="categClass">
                            {% for color in plant.colors %}
                            <div class="categComponent">{{ color.Name }}</div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

            </section>
        </div>

        <div class="modifyField">
            <a href="{{ path('userPlants.details.edit', {name: plant.Name, id: plantdetail.id}) }}">
                <button class="modifyButton">Modification de votre plante</button>
            </a>
        </div>

    </div>
</main>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}
Détail de la plante
{{ parent() }}
{% endblock %}

{% block body %}

{% include "Layout/nav.html.twig" %}
<h1 class="h1Detail">Détail de ma plante</h1>
<div class="detailContainer">

    <aside>
        {# <span class="return">
        <a href="{{ path('users.index') }}"><img src="{{ asset('img/components/Cross.svg') }}"
                alt="Retour arrière"></a>
    </span> #}
        <div class="plantPic">
            <img src="{{ vich_uploader_asset(plant, 'image') }}" alt="{{ plant.name }}">
        </div>

    </aside>
    <main>
        <div class="plantCard">
            <div class="cardText">
                <div class="delButton">
                    <form action="{{path('userPlants.details.delete', {name: plant.Name, id: plantdetail.id}) }}"
                        method="POST"
                        onsubmit="return confirm('Êtes-vous certain de vouloir supprimer cette plante? Cette action est irréversible')"
                        enctype="multipart/form-data">
                        <input type="hidden" name="token" value="{{ csrf_token('delete'~ plantdetail.id) }}">
                        <label for="removePlant" class="categFont">Supprimer cette plante</label>
                        <button type="submit" class="removePlant" id="removePlant">
                            <img src="{{ asset('img/components/minus.png') }}" alt="Bouton de suppression moins">
                        </button>
                    </form>
                </div>

                <section>
                    <div class="plantHeader">
                        <h2>Plante : {{ plant.Name }}</h2>
                        <h4>Espèce : {{ plant.species.Name }}</h4>
                    </div>

                    <div class="plantInfos">
                        <div class="categInfos">
                            <span class="categFont">Description:</span>
                            <p class="categDescription">{{ plant.Description }}</p>
                        </div>
                </section>

                <section>
                    <div class="categFields">

                        <span class="categFont">Statut de la plante:</span>
                        <div class="categUnit">
                            <div class="categClass">
                                {% if plantdetail.HealthStatus %}
                                <p class="categComponent">{{ plantdetail.HealthStatus.Name }}</p>

                                {% else %}
                                <p>Aucun statut de santé précisé.</p>
                                {% endif %}
                            </div>
                        </div>

                        <span class="categFont">Maladies: </span>
                        <div class="categUnit">

                            <div class="categClass">
                                {% if plantdetail.diseases|length > 0 %}
                                {% if plantdetail.HealthStatus.Name == "Malade" %}
                                {% for disease in plantdetail.diseases %}
                                <p class="categComponent">{{ disease.Name }}</p>
                                {% endfor %}
                                {% else %}
                                <p>Aucune maladie précisée.</p>
                                {% endif %}
                                {% endif %}
                            </div>
                        </div>

                        <span class="categFont">Description de la maladie:</span>
                        <div class="categUnit">
                            <div class="categClass">
                                {% if plantdetail.diseases|length > 0 %}
                                {% if plantdetail.HealthStatus.Name == "Malade" %}

                                {% for disease in plantdetail.diseases %}
                                <p class="categDescription">{{ disease.Description }}</span>
                                    {% endfor %}
                                    {% else %}
                                    <p class="resetBackground"></p>
                                    {% endif %}
                                    {% endif %}
                            </div>
                        </div>

                        <span class="categFont">Journal: </span>
                        <div class="categUnit">

                            <div class="categClass">
                                {% if plantdetail.Journal %}
                                <div class="diaryClass">{{ plantdetail.Journal|nl2br }}</div>
                                {% else %}
                                <p>Aucun journal disponible.</p>
                                {% endif %}
                            </div>
                        </div>

                        <span class="categFont">Catégorie(s)</span>
                        <div class="categUnit">
                            <div class="categClass">
                                {% for category in plant.categories %}
                                <p class="categComponent">{{ category.Name }}</p>
                                {% endfor %}
                            </div>
                        </div>

                        <span class="categFont">Saisonalité</span>
                        <div class="categUnit">
                            <div class="categClass">
                                {% for season in plant.seasons %}
                                <p class="categComponent">{{ season.Name }}</p>
                                {% endfor %}
                            </div>
                        </div>

                        <span class="categFont">Arrosage</span>
                        <div class="categUnit">
                            <div class="categClass">

                                {% if plant.watering %}
                                <p class="categComponent">{{ plant.watering.quantity }} ml</p>
                                {% else %}
                                <p class="categComponent">Aucun arrosage défini</p>
                                {% endif %}

                                {% if plant.watering %}
                                <p class="categComponent">1 fois tous les {{ plant.watering.frequency }} jours</p>
                                {% else %}
                                <p class="categComponent">Aucun arrosage défini</p>
                                {% endif %}
                            </div>
                        </div>

                        <span class="categFont">Couleurs</span>
                        <div class="categUnit">
                            <div class="categClass">
                                {% for color in plant.colors %}
                                <p class="categComponent">{{ color.Name }}</p>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                </section>
            </div>

            <div class="modifyField">
                <a href="{{ path('userPlants.details.edit', {name: plant.Name, id: plantdetail.id}) }}">
                    <button class="modifyButton">Modification de votre plante</button>
                </a>
            </div>

        </div>
    </main>
</div>
{% endblock %}


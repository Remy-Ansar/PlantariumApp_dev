{% extends 'base.html.twig' %}

{% block title %}
Modification de votre plante
{{ parent() }}
{% endblock %}

{% block body %}
{% include "Layout/nav.html.twig" %}
<aside>
    <div class="plantPic">
        <img src="{{ vich_uploader_asset(plant, 'image') }}" alt="{{ plant.name }}">
    </div>

</aside>
<main>
    <div class="plantCard">
        <div class="cardText">

            <section>
                <div class="plantHeader">
                    <h2>Plante : {{ plant.Name }}</h2>
                    <h4>Espèce: {{ plant.species.Name }}</h4>
                </div>

                <div class="plantInfos">
                    <div class="categInfos">
                        <span class="categFont">Description:
                            <p class="categDescription">{{ plant.Description }}</p>
                        </span>
                    </div>
            </section>

            <section>
                <div class="categFields">

                    {{form_start(form)}}

                    <div class="categFont">
                        {{ form_row(form.HealthStatus, {'attr': {'id': 'health-status-select'}}) }}
                    </div>
                    
                    <div id="diseases-container" class="hidden">
                        {{ form_row(form.diseases) }}
                    </div>

                    <div class="categFont">
                        {{ form_row(form.newJournalEntry, {'attr': {'id': 'diary', 'class': 'textareaClass'}}) }}
                    </div>

                    <span class="categFont">Catégorie(s)</span>
                    <div class="categUnit">
                        <div class="categClass">
                            {% for category in plant.categories %}
                            <span class="categComponent">{{ category.Name }}</span>
                            {% endfor %}
                        </div>
                    </div>

                    <span class="categFont">Saisonalité</span>
                    <div class="categUnit">
                        <div class="categClass">
                            {% for season in plant.seasons %}
                            <div class="categComponent">{{ season.Name }}</div>
                            {% endfor %}
                        </div>
                    </div>

                    <span class="categFont">Arrosage</span>
                    <div class="SelectUnit">
                        <div class="selectClass">

                            {% if plant.watering %}
                            <div class="categComponent">{{ plant.watering.quantity }} ml</div>
                            {% else %}
                            <div class="categComponent">Aucun arrosage défini</div>
                            {% endif %}

                            {% if plant.watering %}
                            <div class="categComponent">1 fois tous les {{ plant.watering.frequency }} jours</div>
                            {% else %}
                            <div class="categComponent">Aucun arrosage défini</div>
                            {% endif %}
                        </div>
                    </div>

                    <span class="categFont">Couleurs</span>
                    <div class="categUnit">
                        <div class="categClass">
                            {% for color in plant.colors %}
                            <div class="categComponent">{{ color.Name }}</div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

            </section>
        </div>

        <button type="submit" class="modifyButton">Modifier</button>
        {{ form_end(form) }}

    </div>
</main>

{% endblock %}

{% block javascript %}
{# <script>
    src = "{{ asset('/assets/javascript/diseasesField.js') }}"
</script> #}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Prevent form submission when fields change
        const form = document.querySelector('form');
        const modifyButton = document.querySelector('.modifyButton');
        // Add event listeners to all select elements
        const selectElements = form.querySelectorAll('select');
        selectElements.forEach(function(select) {
            select.addEventListener('change', function(event) {
                event.stopImmediatePropagation(); // Prevent default form submission on change
            });
        });
        // Allow form submission only when the modify button is clicked
        modifyButton.addEventListener('click', function(event) {
            event.preventDefault(); // Prevent default action
            form.submit(); // Manually submit the form
        });
    });
</script>
{% endblock %}
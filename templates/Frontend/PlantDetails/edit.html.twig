{% extends 'base.html.twig' %}

{% block title %}
Modification de votre plante
{{ parent() }}
{% endblock %}

{% block body %}
{% include "Layout/nav.html.twig" %}
<h1 class="h1Detail">Modifier ma plante</h1>
<div class="detailContainer">
    <aside>
        <div class="plantPic">
            <img src="{{ vich_uploader_asset(plant, 'image') }}" alt="{{ plant.name }}">
        </div>

    </aside>
    <main>
        <div class="plantCard">
            <div class="cardText">
                <!-- Section contenant des informations sur la plante -->
                <section>
                    <div class="plantHeader">
                        <h2>Plante : {{ plant.Name }}</h2>
                        <h4>Espèce : {{ plant.species.Name }}</h4>
                    </div>
                    <div class="plantInfos">
                        <div class="categInfos">
                            <span class="categFont">Description:</span>
                            <p class="categDescription">{{ plant.Description }}</p>
                        </div>
                </section>

                <!-- Autre section pour le journal -->
                <section>
                    <div class="categFields">
                        <span class="categFont">Journal: </span>
                        <div class="categUnit">
                            <div class="categClass">
                                {% if plantdetail.Journal %}
                                <div class="diaryClass">{{ plantdetail.Journal|nl2br }}</div>
                                {% else %}
                                <p>Aucun journal disponible.</p>
                                {% endif %}
                            </div>
                        </div>
                </section>

                <!-- La balise de fermeture de plantCard est ici -->
            </div>
        </div>

        <!-- Ensuite, le formulaire est en dehors du div plantCard -->
        <section id="diseaseForm">
            {{ form_start(form) }}
            <div class="categFont">
                {{ form_row(form.HealthStatus, {'attr': {'id': 'health-status-select'}}) }}
            </div>
            <div id="diseases-container" class="hidden">
                {{ form_row(form.diseases) }}
            </div>
            <div class="categFont">
                {{ form_row(form.newJournalEntry, {'attr': {'id': 'diary', 'class': 'textareaClass'}}) }}
            </div>
            <button type="submit" class="modifyButton">Confirmer les modifications</button>
            {{ form_end(form) }}
        </section>


</main>
</div>
{% endblock %}
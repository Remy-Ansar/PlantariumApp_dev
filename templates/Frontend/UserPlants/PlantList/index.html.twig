{% extends "base.html.twig" %}

{% block title %}
Administration des plantes
{{ parent() }}
{% endblock %}

{% block body %}
{% include "Layout/nav.html.twig" %}
<main>
    <h1>Plantarium</h1>
    <h2>Rechercher une plante</h2>
    <div>
        {# Messages flash pour les succès #}
        {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {# Messages flash pour les informations #}
        {% for message in app.flashes('info') %}
        <div class="alert alert-info">{{ message }}</div>
        {% endfor %}

        {# Messages flash pour les erreurs #}
        {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

    </div>

    <section>
        <div class="formSearch">
            <form method="get" action="{{ path('users.plantarium') }}">
                <div class="searchBar">
                    <input type="text" name="name" class="searchText" placeholder="Rechercher par nom">
                
                </div>

        </div>

        <div class="filterDisplay">

           <button class="filterButton" type="button">
                <img src="{{ asset('img/components/entonnoir.png')}}" width="25px" height="25px"
                    alt="Icône d'entonnoir">Filtres avancés
            </button>

            <div class="filters hidden">
                <div class="filterGroup">
                    <label for="species">Espèce</label>
                    <select name="species" id="species">
                        <option value="">-- Choisir une espèce --</option>
                        {% for specie in species %}
                        <option value="{{ specie.id }}">{{ specie.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filterGroup">
                    <label for="families">Famille</label>
                    <select name="families" id="families">
                        <option value="">-- Choisir une famille --</option>
                        {% for family in families %}
                        <option value="{{ family.id }}">{{ family.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filterGroup">
                    <label for="colors">Couleur</label>
                    <select name="colors" id="colors">
                        <option value="">-- Choisir une couleur --</option> <!-- Corrigé ici -->
                        {% for color in colors %}
                        <option value="{{ color.id }}">{{ color.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filterGroup">
                    <label for="seasons">Saison</label>
                    <select name="seasons" id="seasons">
                        <option value="">-- Choisir une saison --</option> <!-- Corrigé ici -->
                        {% for season in seasons %}
                        <option value="{{ season.id }}">{{ season.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filterGroup">
                    <label for="categories">Catégorie </label>
                    <select name="categories" id="categories">
                        <option value="">-- Choisir une catégorie --</option> <!-- Corrigé ici -->
                        {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="buttonAlign">
                        <button type="submit" class="modifyButton">Rechercher</button>
                        <button type="reset" class="resetButton"><a href="{{ path('users.index') }}">Tout afficher</a></button>
                    </div>
                </div>

            </form>
        </div>
    </section>

    <br>

    <div class="plantContainer">
        <div class="mainCardsUser">
            <div class="mainCardsPlantarium">
                {% include 'Frontend/UserPlants/PlantList/_plantList.html.twig' %}
            </div>
        </div>
    </div>

    

</main>

<div class="navigation">
        <span>Page(s){{ knp_pagination_render(pagination)  }}</span>
    </div>
{% endblock %}
{% block javascript %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const filterButton = document.querySelector('.filterButton');
    const filters = document.querySelector('.filters');
  
    filterButton.addEventListener('click', function () {
      if (filters.classList.contains('visible')) {
        filters.classList.remove('visible');
        filterButton.lastChild.textContent = 'Filtres avancés'; // Texte du bouton lorsqu'il est fermé
      } else {
        filters.classList.add('visible');
        filterButton.lastChild.textContent = 'Masquer les filtres'; // Texte du bouton lorsqu'il est ouvert
      }
    });
  });
</script>
{% endblock %}
<div class="cardUser">
    <a href="{{ path('userPlants.details', {name: userPlant.plant.Name, id: userPlant.id}) }}">
        <div class="img-container">
            <img src="{{ vich_uploader_asset(userPlant.plant, 'image') }}" alt="{{ userPlant.plant.name }}">
            <div class="gradient-overlay"></div>
        </div>
    </a>
    <div class="plantTitle">
        <p>{{ userPlant.plant.species.Name }}</p>
        <p>{{ userPlant.plant.name }}</p>
    </div>
</div>
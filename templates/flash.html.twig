{% for flash in app.flashes('error') %}
    <div class="alert alert-danger" role="alert">
        <img src="{{ asset('img/components/erreur.png') }}" alt="Icône d'erreur" width="100px" height="100px">
        {{flash}}
    </div>
{% endfor %}

{% for flash in app.flashes('success') %}
    <div class="alert alert-success" role="alert">
        <img src="{{ asset('img/components/succes.png') }}" alt="Icône de réussite" width="100px" height="100px">
        {{flash}}
    </div>
{% endfor %}

{% for flash in app.flashes('warning') %}

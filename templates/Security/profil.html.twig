{% extends "base.html.twig" %}

{% block title %}
inscription
{{ parent() }}
{% endblock %}
{% block body %}

<body class="inscription">

	<main>
		<h1 class="mainTitle">PlantariumApp</h1>
		<h2>Personalisation de votre profil</h2>
		<span>
			<p class="animP">Première étape :</p>
		</span>
		<section>
			{{form_start(form)}}
			{{form_widget(form) }}
			<button class="validationButton" type="submit">Valider</button>
			{{form_end(form)}}

		</section>
		<section class="logReg">
			<ul>
				<li>
					<a href="{{ path('app.inscription') }}" class="link">
						<button class="menuButton">S'inscrire</button>
					</a>
				</li>
				<li>
					<a href="{{ path('app.connexion') }}" class="link">
						<button class="menuButton">Se connecter</button>
					</a>
				</li>
			</ul>
		</section>
	</main>
</body>
{% endblock %}

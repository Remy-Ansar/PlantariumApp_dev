{% extends "base.html.twig" %}

{% block title %}
inscription
{{ parent() }}
{% endblock %}
{% block body %}

<body style="background-image:url('{{ asset('img/background/RegisterBackground.png') }}')">

	<main>
<h1 id="homeTitle"><img src="{{asset('img/components/PlantariumApp.png')}}" alt="Logo plantariumApp"></h1>
		<h2>Personalisation de votre profil</h2>
		<span>
			<p class="animP">Deuxième étape :</p>
		</span>

		<section>
			<div class="formDisplay">
				{{form_start(form)}}
				{{form_widget(form) }}
				<button class="validationButton" type="submit">Valider</button>
				{{form_end(form)}}
			</div>

		</section>
		<section class="logReg">
			<ul>
				<li>
					<a href="{{ path('app.inscription') }}" class="link">
						<button class="modifyButton">S'inscrire</button>
					</a>
				</li>
				<li>
					<a href="{{ path('app.connexion') }}" class="link">
						<button class="modifyButton">Se connecter</button>
					</a>
				</li>
			</ul>
		</section>
	</main>
</body>
{% endblock %}
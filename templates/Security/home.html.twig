{% block title %}
Home
{{ parent() }}
{% endblock %}

{% block body_class %}home{% endblock %}
{% block body %}

<body class="home">
	{# <aside class="HomeImage">
	 <img  src="{{ asset('img/background/pexels-julia-volk-6297518.jpg') }}" alt="Photo de Monstera" width="100vw" height="100px">
</aside> #}
	<main>
	<div class="fadeIn">
		<h1 id="homeTitle">PlantariumApp</h1>
		<section class="homemessage">

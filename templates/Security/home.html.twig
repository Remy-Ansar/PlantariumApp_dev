{% extends "base.html.twig" %}

{% block title %}
Home
{{ parent() }}
{% endblock %}

{% block body_class %}home{% endblock %}
{% block body %}

<body style="background-image:url('{{ asset('img/background/ConnexionBackground.png') }}')">

	<main>
		<div class="fadeIn">
			<h1 id="homeTitle"><img src="{{asset('img/components/PlantariumApp.png')}}" alt="Logo plantariumApp"></h1>

			<section class="homemessage">
				<p>Bienvenue,</p>
				<br>
				<p>PlantariumApp est une plateforme conçue pour faciliter la gestion et le suivi des plantes.
					<br>
					Que vous soyez amateur de jardinage, botaniste, ou propriétaire d'une pépinière, cette application
					vous
					permet de cataloguer vos plantes,
					<br>
					de suivre leur croissance, et de diagnostiquer leurs maladies à
					l'aide de diverses fonctionnalités interactives.</p>
				
				
			</section>
<p>Commencez par vous inscrire ou connectez-vous pour utiliser PlantariumApp.</p>
			<section class="logReg">
			
				<ul>
					<li>
						<a href="{{ path('app.inscription') }}" class="link">
							<button class="modifyButton">S'inscrire</button>
						</a>
					</li>
					<li>
						<a href="{{ path('app.connexion') }}" class="link">
							<button class="modifyButton">Se connecter</button>
						</a>
					</li>
				</ul>
			</section>
		</div>
	</main>

</body>

{% endblock %}
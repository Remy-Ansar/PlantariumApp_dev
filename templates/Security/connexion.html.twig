{% extends "base.html.twig" %}

{% block title %}
Connexion
{{ parent() }}
{% endblock %}
{% block body %}

<body class="connexion">

	<main>
		<h1>PlantariumApp</h1>
		<h2>Se connecter</h2>
		<span>{% for message in app.flashes('success') %}
			<div class="alert alert-success">{{ message }}</div>
			{% endfor %}
			{% for message in app.flashes('error') %}
			<div class="alert alert-danger">{{ message }}</div>
			{% endfor %}</span>

		<section>
			<form action="{{ path('app.connexion') }}" method="post">
				
					<label for="email">Veuillez entrer votre adresse mail</label>
					<input type="email" id="email" name="_username" value="{{ lastUsername }}"
						placeholder="john@example.com">
				
					<label for="password">Votre mot de passe</label>
					<input type="password" id="password" name="_password"="form-control" placeholder="S3CR3T">

					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
					<button class="validationButton" type="submit">Connexion</button>
					
			</form>
		</section>

		<span>
		<p>Mot de passe oublié ? <br> Cliquez <a href="{{ path('app_forgot_password_request') }}"><u>ici</u></a> pour le
			réinitialiser</p>
			</span>

		<section class="logReg">
			<ul>
				<li>
					<a href="{{ path('app.inscription') }}" class="link">
						<button class="menuButton">S'inscrire</button>
					</a>
				</li>
				<li>
					<a href="{{ path('app.connexion') }}" class="link">
						<button class="menuButton">Se connecter</button>
					</a>
				</li>
			</ul>
		</section>
	</main>
</body>
{% endblock %}
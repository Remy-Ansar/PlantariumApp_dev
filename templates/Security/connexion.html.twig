{% extends "base.html.twig" %}

{% block title %}
Connexion
{{ parent() }}
{% endblock %}
{% block body %}

<body class="connexion">


	<h1>PlantariumApp</h1>
<h2>Se connecter</h2>
<span>{% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}</span>
	<main>
		
		<form class="formDisplay" action="{{ path('app.connexion') }}" method="post">

			<div>
				<div><label for="email">Veuillez entrer votre adresse mail</label></div>
				<input type="email" id="email" name="_username" value="{{ lastUsername }}"
					placeholder="john@example.com">
			</div>

			<div>
				<div><label for="password">Votre mot de passe</label></div>
				<input type="password" id="password" name="_password"="form-control" placeholder="S3CR3T">

				<div><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
					<button class="validationButton" type="submit">Connexion</button></div>
		</form>

		<p>Mot de passe oublié ? <br> Cliquez <a href="{{ path('app_forgot_password_request') }}"><u>ici</u></a> pour le réinitialiser</p>
	</main>
</body>
{% endblock %}
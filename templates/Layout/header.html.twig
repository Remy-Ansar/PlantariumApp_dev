{% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
 
   <header id="main-header" class="header-hidden">
    <div class="headerContainer">
        

        {% if app.user.UserInfos %}

        {% if app.user.UserInfos.imageName %}
        <ul>
            <li>
                <img src="{{ vich_uploader_asset(app.user.UserInfos, 'image') }}" class="profilePic"
                    alt="{{ app.user.UserInfos.getFullName() }}" loading="lazy">
            </li>

            {% endif %}

            <li>
                <p>{{ app.user.UserInfos.getFirstName() }}</p>

                <p>{{ app.user.UserInfos.getLastName() }}</p>
            </li>
        </ul>
        {% endif %}
    </div>
 {% if is_granted('ROLE_ADMIN') %}
<div class="dropdown">
    <button type="button" class="dropdown-toggle"><img src="{{ asset('img/components/feuille.png')}}" width="25px" height="25px" alt="Bouton feuille"></button>

    <div class="adminAccess">
           
        
            {# <button type="button" class="dropdown-toggle">Administration</button> #}
            <div class="dropdown-menu">
                <ul>
                    <li><a href="{{ path('admin.users.index') }}">Administration des utilisateurs</a></li>
                    <li id="separator"><a href="{{ path('editor.plants.index') }}">Administration des plantes</a></li>
                </ul>
            </div>
        </div>
        {% endif %}

        {% if is_granted('ROLE_EDITOR') %}
        <div class="dropdown">
            <button type="button" class="dropdown-toggle">Administration</button>
            <div class="dropdown-menu">
                <ul>
                    <li><a href="{{ path('editor.plants.index') }}">Administration des plantes</a></li>
                </ul>
            </div>
        </div>
        {% endif %}
    </div>


    <div>
        <ul>
            <li>
                <a href="{{ path('app_logout') }}" class="link">
                    <button class="loggout">
                        <img src="{{ asset('img/components/deconnexion.png') }}" width="25px" height="25px"
                            alt="Icône de deconnexion">
                    </button>
                </a>
            </li>
        </ul>
    </div>
    
    {% else %}

    {% endif %}

</header>
 <button id="toggle-header-button" aria-expanded="true" aria-controls="main-header">
  PlantariumApp
    </button>
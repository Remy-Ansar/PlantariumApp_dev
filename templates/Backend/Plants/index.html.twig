{% extends "base.html.twig" %}

{% block title %}
Administration des plantes
{{ parent() }}
{% endblock %}

{% block body %}
{% include "Layout/nav.html.twig" %}

<main>
    
        <h1>Administration des plantes</h1>

        <section>
            <div class="formSearch">
                <form method="get" action="{{ path('editor.plants.index') }}">
                    <div class="searchBar">
                        <input type="text" name="name" class="searchText" placeholder="Rechercher par nom">
                   
                    </div>

            </div>
            <div class="filterDisplay">

                <button class="filterButton" type="button">
                    <img src="{{ asset('img/components/entonnoir.png')}}" width="25px" height="25px"
                        alt="Icône d'entonnoir">Filtres avancés
                </button>

                <div class="filters hidden">
                    <div class="filterGroup">
                        <label for="species">Espèce</label>
                        <select name="species" id="species">
                            <option value="">-- Choisir une espèce --</option>
                            {% for specie in species %}
                            <option value="{{ specie.id }}">{{ specie.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filterGroup">
                        <label for="families">Famille</label>
                        <select name="families" id="families">
                            <option value="">-- Choisir une famille --</option>
                            {% for family in families %}
                            <option value="{{ family.id }}">{{ family.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filterGroup">
                        <label for="colors">Couleur</label>
                        <select name="colors" id="colors">
                            <option value="">-- Choisir une couleur --</option> <!-- Corrigé ici -->
                            {% for color in colors %}
                            <option value="{{ color.id }}">{{ color.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filterGroup">
                        <label for="seasons">Saison</label>
                        <select name="seasons" id="seasons">
                            <option value="">-- Choisir une saison --</option> <!-- Corrigé ici -->
                            {% for season in seasons %}
                            <option value="{{ season.id }}">{{ season.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filterGroup">
                        <label for="categories">Catégorie </label>
                        <select name="categories" id="categories">
                            <option value="">-- Choisir une catégorie --</option> <!-- Corrigé ici -->
                            {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="buttonAlign">
                        <button type="submit" class="modifyButton">Rechercher</button>
                        <button type="reset" class="resetButton"><a href="{{ path('editor.plants.index') }}">Tout afficher</a></button>
                    </div>
                </div>

                </form>
            </div>
        </section>

        <div class="fieldAdd">
            <div>
                <a href="{{ path('editor.plants.new') }}">
                    <button class="modifyButton">Ajouter une plante</button>
                </a>
            </div>
            <div>
                <a href="{{ path('editor.plants.field.index') }}">
                    <button class="modifyButton">Ajouter des champs</button>
                </a>
            </div>
        </div>
   

 <div class="table-containerMain">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Espèce</th>
                <th>Nom</th>
                <th>Famille</th>
                <th>Description</th>
                <th>Couleurs</th>
                <th>Saisons</th>
                <th>Catégorie</th>
                <th>Photo</th>
                <th>Visible</th>
                <th>Modifier</th>
                <th>Supprimer</th>
            </tr>
        </thead>
        <tbody>
            {% if pagination.items is empty %}
            <tr>
                <td colspan="12">Aucune plante ne correspond à votre recherche.</td>
            </tr>
            {% else %}
            {% for plant in pagination.items %}
            <tr>
                <td>{{ plant.id }}</td>
                <td>{{ plant.species.name }}</td>
                <td>{{ plant.name }}</td>
                <td>{{ plant.families.name }}</td>
                <td class="description">{{ plant.description }}</td>
                <td>
                    {% for color in plant.colors %}
                    <p class="tagFont">{{ color.name }}</p>
                    {% endfor %}
                </td>
                <td>
                    {% for season in plant.seasons %}
                    <p class="tagFont">{{ season.name }}</p>
                    {% endfor %}
                </td>
                <td>
                    {% for category in plant.categories %}
                    <p class="tagFont">{{ category.name }}</p>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('editor.plants.showPlant', {name: plant.name}) }}">
                        <img src="{{ vich_uploader_asset(plant, 'image') }}" alt="{{ plant.name }}" loading="lazy"
                            class="plantPicprofile">
                    </a>
                </td>
                <td>
                    <button class="toggle-plant" data-id="{{ plant.id }}"
                        data-url="{{ path('editor.plants.switch', {'id': plant.id}) }}">
                        <img src="{{ plant.isEnable() ? asset('images/components/commutateur_on.png') : asset('images/components/commutateur_off.png') }}"
                            alt="{{ plant.isEnable() ? 'Désactiver' : 'Activer' }}">
                    </button>
                </td>
                <td>
                    <a href="{{ path('editor.plants.edit', {id: plant.id}) }}">
                        <button class="modifyButton">Modifier</button>
                    </a>
                </td>
                <td>
                    <form action="{{ path('editor.plants.delete', {id: plant.id}) }}" method="POST"
                        onsubmit="return confirm('Êtes-vous certain de vouloir supprimer cette plante? Cette action est irréversible')">
                        <input type="hidden" name="token" value="{{ csrf_token('delete' ~ plant.id) }}">
                        <button type="submit" class="deleteButton">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
            {% endif %}
        </tbody>
    </table>
</div>

</main>

<div class="navigation">
    <span>Page(s){{ knp_pagination_render(pagination)  }}</span>
</div>

{% endblock %}
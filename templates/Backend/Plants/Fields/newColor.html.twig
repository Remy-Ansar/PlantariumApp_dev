{% extends 'base.html.twig' %}

{% block title %}
Ajouter une couleur
{{ parent() }}
{% endblock %}

{% block body %}
{% include "Layout/nav.html.twig" %}
<main>
    <h1>Ajouter une nouvelle couleur</h1>

    <div class="mainContainer">
        <section>
            {% include 'Backend/Plants/Fields/_form.html.twig' with {button_label: 'Créer'} %}

            {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
            {% endfor %}
        </section>
        <a href="{{ path('editor.plants.field.index') }}" class="alternativeTagsButton">Retour à la liste</a>
    </div>
</main>

{% endblock %}
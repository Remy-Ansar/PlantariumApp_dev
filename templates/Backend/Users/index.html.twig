{% extends "base.html.twig" %}

{% block title %}
Administration des utilisateurs
{{ parent() }}
{% endblock %}
{% block body %}
{% include "Layout/nav.html.twig" %}

<main class="wideTable">
    <h1>Administration des utilisateurs</h1>

    {# <section>
        <div class="formSearch">
            <form method="get" action="{{ path('admin.users.index') }}">
                <div class="searchBar">
                    <input type="text" name="name" class="searchText" placeholder="Rechercher par nom">
                </div>
    </section> #}

    <div class="table-containerMain">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Nom complet</th>
                    <th>Niveau</th>
                    <th>Photo</th>
                    <th>Modifier</th>
                    <th>Supprimer</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td>{{ user.getFullName() }}</td>
                    <td>{{ user.getUserLevel() }}</td>
                    <td>
                        <a href="#">
                            {% if user.UserInfos and user.UserInfos.imageName %}
                            <img src="{{ vich_uploader_asset(user.UserInfos, 'image') }}" alt="{{ user.getFullName() }}"
                                class="alternativProfilePic" loading="lazy">
                            {% endif %}
                        </a>
                    </td>
                    <td><a href="{{ path('admin.users.edit', {id: user.id}) }}"><button type="button"
                                class="modifyButton">Modifier</button></a></td>
                    <td>
                        <form action="{{ path('admin.users.delete', {id: user.id}) }}" method="POST"
                            onsubmit="return confirm('Êtes-vous certain de vouloir supprimer cet utilisateur? Cette action est irréversible')"
                            enctype="multipart/form-data">
                            <input type="hidden" name="token" value="{{ csrf_token('delete'~ user.id) }}">
                            <button type="submit" class="deleteButton">Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
<div class="navigation">
    <span>{{ knp_pagination_render(pagination)  }}</span>
</div>

{% endblock %}
{% block javascript %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const filterButton = document.querySelector('.filterButton');
    const filters = document.querySelector('.filters');
  
    filterButton.addEventListener('click', function () {
      if (filters.classList.contains('visible')) {
        filters.classList.remove('visible');
        filterButton.lastChild.textContent = 'Filtres avancés'; // Texte du bouton lorsqu'il est fermé
      } else {
        filters.classList.add('visible');
        filterButton.lastChild.textContent = 'Masquer les filtres'; // Texte du bouton lorsqu'il est ouvert
      }
    });
  });
</script>
{% endblock %}
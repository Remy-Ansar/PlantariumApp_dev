{% extends "base.html.twig" %}

{% block title %}
Administration des utilisateurs
{{ parent() }}
{% endblock %}
{% block body %}
{% include "Layout/nav.html.twig" %}

<main>
    <div class="headerMain">
        <h1>Plantarium</h1>
        <h2>Administration des utilisateurs</h2>

        <div class="wrap">
            <form method="get" action="{{ path('admin.users.index' ) }}">
                <div class="searchBar">
                    <input type="text" name="FirstName" class="searchText" placeholder="Prénom">
                    <input type="text" name="LastName" class="searchText" placeholder="Nom">
                    <button type="submit" class="searchSubmit">
                        <img src="{{ asset('images/components/loupe.png') }}" alt="Loupe grossissante">
                    </button>
                </div>
                 <button type="submit" class="tagsButton">Rechercher</button>
            </form>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Nom complet</th>
                    <th>Niveau</th>
                    <th>Photo</th>
                    <th>Modifier</th>
                    <th>Supprimer</th>
                </tr>
            </thead>
            <tbody>
                {% for userInfo in usersInfos %}
                <tr>
                    <td>{{ userInfo.users.id }}</td>
                    <td>{{ userInfo.users.email }}</td>
                    <td>{{ userInfo.users.roles|join(', ') }}</td>
                    <td>{{ userInfo.getFullName() }}</td>
                    <td>{{ userInfo.getLevel() }}</td>
                    <td>
                        <a href="#">
                            {% if userInfo.imageName %}
                            <img src="{{ vich_uploader_asset(userInfo, 'image') }}" alt="{{ userInfo }}"
                                class="profilePic" loading="lazy" width="100px" height="100px">
                            {% endif %}
                        </a>
                    </td>
                    <td><a href="{{ path('admin.users.edit', {id: userInfo.users.id}) }}"><button
                                class="modifyButton">Modifier</button></a></td>
                    <td>
                        <form action="{{ path('admin.users.delete', {id: userInfo.users.id}) }}" method="POST"
                            onsubmit="return confirm('Êtes-vous certain de vouloir supprimer cet utilisateur? Cette action est irréversible')"
                            enctype="multipart/form-data">
                            <input type="hidden" name="token" value="{{ csrf_token('delete'~ userInfo.users.id) }}">
                            <button type="submit" class="deleteButton">Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
<div class="navigation">
    <span>Page(s){{ knp_pagination_render(pagination)  }}</span>
</div>

{% endblock %}